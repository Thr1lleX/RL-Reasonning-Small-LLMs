ll-false satisfies all rules.\n\nFINAL: gem=WHITE; B1=F; W1=T; K1=F"}], "metadata": {"n_statements": 3, "gem_box": "WHITE", "relational_ratio": 0.796, "ast_prob": 0.349, "max_depth": 1}}
